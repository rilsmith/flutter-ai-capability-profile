GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID_HERE
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET_HERE
# Local dev only (http://localhost:5000/auth). The web app bakes this value in
# at compile time via --dart-define, so CLUSTER builds must pass the ingress
# URI instead:
#   https://ai-capability-dashboard.corp.ethos270-stage-va7.ethos.adobe.net/auth
# See k8s/README.md ("Container images") before building the web image.
REDIRECT_URI=YOUR_REDIRECT_URI_HERE
LDAP_URL=YOUR_LDAP_URL_HERE
LDAP_BASE_DN=YOUR_LDAP_BASE_DN_HERE
# Optional bind credentials for LDAP lookups. The directory ACLs hide the
# "manager" attribute from anonymous readers, so team endpoints need a bind
# account. Leave unset for anonymous access (single-user local dev).
LDAP_BIND_DN=YOUR_LDAP_BIND_DN_HERE
LDAP_PASSWORD=YOUR_LDAP_PASSWORD_HERE
DATABASE_URL=YOUR_DATABASE_URL_HERE
CORS_ORIGIN=YOUR_CORS_ORIGIN_HERE
WEB_DIR=build/web
# Local development only: set to 'true' to allow a GitHub token whose primary email is unverified.
# This must NOT be enabled in production.
ALLOW_UNVERIFIED_TEST_EMAIL=false
